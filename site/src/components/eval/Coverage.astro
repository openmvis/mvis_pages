---
// Solved n of N per tool (one square per recording, anonymous order; poor solves grey and not counted, their
// reason under the family's read-first line), the reason where a tool did not run, the
// record files behind every number, and the fit (reprojection median) folded: fit of each tool's own model.
// One MVIS lane per family (f.imu_model, camera + IMU only): 'kalibr' = the run with Kalibr's IMU model, 'default' =
// MVIS's default model where a family has no such run. The line under the squares says which.
import RpShape from '../RpShape.astro';
interface Props { page: any; i: number }
const { page, i } = Astro.props;
const f = page.families[i];
const alone = f.solved.every((s: any) => s.tool === 'MVIS' || s.reason);  // no other tool ran on this family
---
<div class="not-content ev-cov">
  <ul class="ev-solved">
    {f.solved.map((s: any) => (
      <li>
        <span class="ev-tool"><RpShape tool={s.tool} /> {s.tool}</span>
        <span class="ev-sq" aria-hidden="true">{Array.from({ length: s.of }, (_, k) => <i class={k < s.n - (s.poor ?? 0) ? `rp-bg-${s.tool}` : k < s.n ? 'ev-poorsq' : 'ev-empty'}></i>)}</span>
        <span class="ev-n">{s.n - (s.poor ?? 0)} of {s.of}</span>
        {s.reason && <span class="ev-why">{s.reason}</span>}
        {s.poor > 0 && <span class="ev-why">{s.poor} more solved, poor quality (grey)</span>}
      </li>
    ))}
  </ul>
  {f.imu_model === 'kalibr' && <p class="ev-small">For a fair comparison, MVIS is run here with Kalibr's IMU model, so its gyro and accel terms mean the same as Kalibr's. MVIS still estimates t_ga and refines the camera intrinsics.</p>}
  {f.imu_model === 'default' && <p class="ev-small">MVIS here uses its default IMU model{alone ? '; no other tool ran on this set' : ''}.</p>}
  {Object.keys(f.records).length > 0 && <p class="ev-small">Records behind these numbers: {Object.entries(f.records).map(([t, u]: [string, any], k: number) => <>{k ? ' · ' : ''}<a href={u}>{t} {f.id}.json</a></>)}{f.imu_model === 'kalibr' && <>. In the MVIS file, this run is the method "MVIS (Kalibr IMU model)".</>}</p>}
  {f.fit.length > 0 && (
    <details class="ev-fold">
      <summary>Fit: reprojection median, px <small>(fit of each tool's own model, not accuracy)</small></summary>
      <div class="ev-tw"><table class="ev-table">
        <thead><tr><th scope="col">Camera</th>{f.columns.map((c: any) => <th scope="col"><RpShape tool={c.tool} /> {c.label}</th>)}</tr></thead>
        <tbody>{f.fit.map((r: any) => <tr><th scope="row">{r.sensor}</th>{f.columns.map((c: any) => <td>{r.by_col[c.col] ?? '–'}</td>)}</tr>)}</tbody>
      </table></div>
    </details>
  )}
</div>

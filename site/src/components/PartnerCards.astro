---
// Thank-you cards for the makers and partners who shared device recordings (About → Acknowledgements).
// Logos come from each company's own website; a company without one gets its name on the plate.
import { partners } from '../data/partners';
---

<div class="pc-grid not-content">
  {partners.map((p) => (
    <article class="pc-card">
      <a class="pc-plate" href={p.site} aria-label={`${p.name} website`}>
        {p.logo ? <img src={p.logo.src} alt={`${p.name} logo`} loading="lazy" /> : <span class="pc-word">{p.name}</span>}
      </a>
      <div class="pc-body">
        <h3 class="pc-name"><a href={p.site}>{p.name}</a></h3>
        {p.full && <p class="pc-full">{p.full}</p>}
        <p class="pc-shared">{p.shared}</p>
        <ul class="pc-devices">
          {p.devices.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
        </ul>
        {p.people && (
          <p class="pc-people"><span class="pc-label">Thanks to</span> <Fragment set:html={p.people.join('; ')} /></p>
        )}
        {p.contact && (
          <p class="pc-contact">{p.contact.map((c) => <a href={c.href}>{c.label}</a>)}</p>
        )}
        {p.card && (
          <details class="pc-fold">
            <summary>Name card</summary>
            <div class="pc-cardimgs">
              <figure><a href={p.card.front.src}><img src={p.card.front.src} width="720" height="900" loading="lazy" alt={`${p.name} name card, front`} /></a><figcaption>Front</figcaption></figure>
              <figure><a href={p.card.back.src}><img src={p.card.back.src} width="720" height="900" loading="lazy" alt={`${p.name} name card, back: the contact details listed below`} /></a><figcaption>Back</figcaption></figure>
            </div>
            <dl class="pc-dl">
              {p.card.lines.map((l) => <Fragment><dt>{l.label}</dt><dd>{l.href ? <a href={l.href}>{l.text}</a> : l.text}</dd></Fragment>)}
            </dl>
          </details>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .pc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1rem; margin-top: 1.25rem; align-items: start; }
  .pc-card { display: flex; flex-direction: column; border: 1px solid var(--sl-color-hairline-light); border-radius: 0.75rem; overflow: hidden; background: var(--sl-color-bg); transition: border-color .15s, transform .15s; }
  .pc-card:hover { border-color: var(--sl-color-accent); transform: translateY(-2px); }
  /* Logos are drawn for light backgrounds, so the plate stays white in both themes. */
  .pc-plate { display: flex; align-items: center; justify-content: center; height: 6rem; padding: 1rem 1.5rem; background: #fff; border-bottom: 1px solid var(--sl-color-hairline-light); text-decoration: none; }
  .pc-plate img { max-height: 3.25rem; max-width: 100%; object-fit: contain; }
  .pc-word { font-size: 1.5rem; font-weight: 800; letter-spacing: .02em; color: #1f2937; }
  .pc-body { padding: 0.9rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .pc-name { margin: 0; font-size: 1.1rem; }
  .pc-name a { color: var(--sl-color-white); text-decoration: none; }
  .pc-name a:hover { color: var(--sl-color-accent-high); }
  .pc-full { margin: 0; font-size: 0.8rem; color: var(--sl-color-gray-3); }
  .pc-shared { margin: 0.2rem 0 0; font-size: 0.9rem; }
  .pc-devices { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.1rem 0 0; padding: 0; list-style: none; }
  .pc-devices li { margin: 0; }
  .pc-devices a { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); font-size: 0.8rem; text-decoration: none; }
  .pc-devices a:hover { background: var(--sl-color-accent); color: var(--sl-color-black); }
  .pc-people, .pc-contact { margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--sl-color-gray-2); }
  .pc-label { font-weight: 600; color: var(--sl-color-white); }
  .pc-contact a { font-size: 0.8rem; }
  /* Name card fold: closed by default; the text list repeats the card for screen readers, search and copying. */
  .pc-fold { margin-top: 0.45rem; padding-top: 0.45rem; border-top: 1px solid var(--sl-color-hairline-light); }
  .pc-fold summary { cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--sl-color-accent-high); }
  .pc-cardimgs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 0.6rem 0 0.5rem; }
  .pc-cardimgs figure { margin: 0; }
  .pc-cardimgs a { display: block; border: 1px solid var(--sl-color-hairline-light); border-radius: 0.4rem; overflow: hidden; }
  .pc-cardimgs img { display: block; width: 100%; height: auto; }
  .pc-cardimgs figcaption { margin-top: 0.15rem; font-size: 0.7rem; text-align: center; color: var(--sl-color-gray-3); }
  .pc-dl { display: grid; grid-template-columns: auto 1fr; gap: 0.1rem 0.7rem; margin: 0; font-size: 0.82rem; }
  .pc-dl dt { margin: 0; color: var(--sl-color-gray-3); }
  .pc-dl dd { margin: 0; overflow-wrap: anywhere; }
</style>

---
// Homepage band body: every device page as a small photo card, then the makers who sent us recordings or units.
// Cards come from the device pages' data (site/src/data/sensors/*.json), so a new device page shows up here by itself;
// its photo is made by site/scripts/export_home_devices.py.
import { partners } from '../data/partners';
import hp from '../assets/makers/hp.svg?raw';
import insta360 from '../assets/makers/insta360.svg?raw';
import samsung from '../assets/makers/samsung.svg?raw';
import valve from '../assets/makers/valve.svg?raw';

// One-colour logos (Simple Icons, CC0) for public-dataset makers; a maker without one keeps its name.
// word: the logo is the name itself, so no text next to it.
const makerLogos: Record<string, { svg: string; word: boolean }> = {
  HP: { svg: hp, word: true }, Insta360: { svg: insta360, word: false }, Samsung: { svg: samsung, word: true }, Valve: { svg: valve, word: true },
};

const all = import.meta.glob('../data/sensors/*.json', { eager: true }) as Record<string, { default: any }>;
const fromPartner = new Set(partners.flatMap((p) => p.devices.map((d) => d.href)));   // device pages a partner sent data for
const devices = Object.entries(all).map(([path, m]) => ({ slug: path.split('/').pop()!.replace('.json', ''), ...m.default.card }));
// Partners' devices first, then the rest; alphabetical by maker inside each group.
devices.sort((a, b) => Number(fromPartner.has(b.href)) - Number(fromPartner.has(a.href)) || a.maker.localeCompare(b.maker));
const company = (maker: string) => (maker === 'RealSense' ? 'Intel RealSense' : maker);   // one brand; the D4xx pages say RealSense (spun out of Intel in 2025)
const makers = [...new Set(devices.map((d) => company(d.maker)))];
// Makers of the devices from public datasets: named and linked to their first device page; the makers in makerLogos
// show their public one-colour logo (kept by the maintainer's choice, 2026-11-18). No agreement with these makers.
const publicMakers = [...new Map(devices.filter((d) => !fromPartner.has(d.href)).map((d) => [company(d.maker), d.href])).entries()]
  .sort(([a], [b]) => a.localeCompare(b));
const shown = [{ slug: 'virig', href: '/datasets/virig-4imus-4cams/', maker: 'OpenMVIS', title: 'VI-Rig',
                 alt: 'The VI-Rig: four cameras and four IMUs on one frame' }, ...devices];
---

<p class="hd-lead">{devices.length} devices from {makers.length} makers ({makers.join(', ')}), plus our own VI-Rig. Each has a page with its calibration, the data and the results.</p>
<ul class="hd-grid" role="list">
  {shown.map((d) => (
    <li>
      <a href={d.href}>
        <img src={`/media/home-devices/${d.slug}.webp`} alt={d.alt} width="360" height="240" loading="lazy" decoding="async" />
        <span class="hd-maker">{d.maker}</span>
        <span class="hd-name">{d.title}</span>
      </a>
    </li>
  ))}
  <li class="hd-all"><a href="/devices/"><span>Browse the device wiki</span></a></li>
</ul>

<p class="hd-kicker">Recordings and units from</p>
<ul class="hd-partners" role="list">
  {partners.map((p) => (
    <li>
      <a href="/about/acknowledgements/" title={`${p.name}: ${p.shared}`}>
        {p.logo ? <img src={p.logo.src} alt={p.name} loading="lazy" /> : <span>{p.name}</span>}
      </a>
    </li>
  ))}
</ul>
<p class="hd-kicker">Also calibrated, from public datasets</p>
<ul class="hd-partners hd-public" role="list">
  {publicMakers.map(([name, href]) => {
    const logo = makerLogos[name];
    return (
      <li><a href={href} aria-label={name} title={name}>
        {logo && <i class:list={['hd-logo', `hd-logo-${name.toLowerCase()}`]} set:html={logo.svg} />}
        {!logo?.word && <span>{name}</span>}
      </a></li>
    );
  })}
</ul>

<style>
  .hd-lead { max-width: 52rem; margin: 18px 0 0; font-size: 1.05rem; line-height: 1.55; color: var(--sl-color-gray-2); }
  .hd-grid { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(7, minmax(0, 1fr)); }   /* 20 cards: 7 + 7 + 6 */
  .hd-grid li { margin: 0; min-width: 0; }
  .hd-grid a { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-hairline); border-radius: 0.6rem; overflow: hidden; background: var(--sl-color-bg); transition: border-color .15s, transform .15s; }
  .hd-grid a:hover { border-color: var(--sl-color-accent); transform: translateY(-2px); }
  .hd-grid a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .hd-grid img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; background: #fff; border-bottom: 1px solid var(--sl-color-hairline); }
  .hd-maker { padding: 8px 10px 0; font-size: 0.7rem; font-weight: 600; line-height: 1.3; color: var(--sl-color-gray-3); }
  .hd-name { padding: 2px 10px 10px; font-size: 0.9rem; font-weight: 700; line-height: 1.25; color: var(--sl-color-white); }
  .hd-all a { align-items: center; justify-content: center; padding: 12px; text-align: center; font-weight: 700; color: var(--sl-color-accent-high); background: var(--sl-color-accent-low); }
  .hd-kicker { margin: 40px 0 12px; font-size: 0.8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .hd-partners { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .hd-partners li { margin: 0; }
  /* Logos are drawn for light backgrounds, so the plate stays white in both themes. */
  .hd-partners a { display: flex; align-items: center; justify-content: center; height: 56px; min-width: 120px; padding: 8px 16px; background: #fff; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; text-decoration: none; }
  .hd-partners img { max-height: 36px; max-width: 140px; object-fit: contain; }
  .hd-partners span { font-size: 1.1rem; font-weight: 800; letter-spacing: .02em; color: #1f2937; }
  .hd-public a { height: 44px; min-width: 0; background: var(--sl-color-bg); }
  .hd-public span { font-size: 1rem; font-weight: 700; color: var(--sl-color-white); }
  .hd-public a:hover { border-color: var(--sl-color-accent); }
  .hd-public a { gap: 8px; color: var(--sl-color-white); }
  .hd-logo { display: flex; font-style: normal; }
  .hd-logo :global(svg) { display: block; height: 22px; width: auto; }
  .hd-logo-hp :global(svg) { height: 28px; }
  .hd-logo-samsung :global(svg) { height: 14px; }
  @media (max-width: 1100px) { .hd-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }   /* 4 rows of 5 */
  @media (max-width: 860px) { .hd-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }    /* 5 rows of 4 */
  /* Phones: one swipeable row instead of ten rows of cards. */
  @media (max-width: 640px) {
    .hd-grid { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 9.5rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
    .hd-grid li { scroll-snap-align: start; }
  }
</style>
